{
  "_comment": "结构示例，不含驱动或真实设备。仅 devices 数组中的设备可执行；_template 不参与匹配。用 scripts/device_registry.py init 在 ~/.wuwu-intelligence/devices.json 建立空档案；旧安装目录内的档案用 migrate 迁移。新命令使用 argv 参数数组和结构化 args，{python} 表示运行工具的 Python。请按设备实际 CLI 登记，示例命令不是通用驱动。",
  "devices": [],
  "_template": {
    "name": "led_matrix_8x8",
    "aliases": [
      "灯板",
      "灯珠",
      "RGB灯",
      "WS2812",
      "矩阵"
    ],
    "description": "ESP32-S3 + WS2812B-64 8x8 全彩 LED 矩阵",
    "project_path": "/path/to/your/RGB_ding",
    "control": {
      "cli": "pc/led_cli.py",
      "lib": "pc/esp32_led.py",
      "transport": "tcp:8888",
      "ip_lookup": "pc/device.json"
    },
    "global_options": {
      "--ip <地址>": "指定设备 IP，成功一次后自动记住，之后可省略",
      "--forget": "清除记住的 IP",
      "--timeout <秒>": "连接超时，默认 3"
    },
    "commands": {
      "color": {
        "desc": "全部灯珠设为同一颜色；关灯就是 0 0 0",
        "args": {
          "r": {
            "type": "integer",
            "description": "红 0-255",
            "minimum": 0,
            "maximum": 255
          },
          "g": {
            "type": "integer",
            "description": "绿 0-255",
            "minimum": 0,
            "maximum": 255
          },
          "b": {
            "type": "integer",
            "description": "蓝 0-255",
            "minimum": 0,
            "maximum": 255
          }
        },
        "argv": [
          "{python}",
          "pc/led_cli.py",
          "color",
          "{r}",
          "{g}",
          "{b}"
        ],
        "idempotent": true,
        "timeout": 10
      },
      "rainbow": {
        "desc": "彩虹色循环流动",
        "args": {
          "speed": {
            "type": "integer",
            "description": "1-100，默认 20，越大越快",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        },
        "argv": [
          "{python}",
          "pc/led_cli.py",
          "rainbow",
          "--speed",
          "{speed}"
        ],
        "idempotent": true,
        "timeout": 10
      },
      "fade": {
        "desc": "平滑渐变到指定的绝对亮度",
        "args": {
          "n": {
            "type": "integer",
            "description": "目标亮度；未指定时设为 128，不推断未知的当前亮度",
            "minimum": 0,
            "maximum": 255,
            "default": 128
          }
        },
        "argv": [
          "{python}",
          "pc/led_cli.py",
          "fade",
          "{n}"
        ],
        "idempotent": true,
        "timeout": 10
      },
      "demo": {
        "desc": "依次展示所有效果，约 30 秒",
        "argv": [
          "{python}",
          "pc/demo.py"
        ],
        "idempotent": false,
        "timeout": 60
      },
      "status": {
        "desc": "查询当前模式、亮度、IP、信号强度",
        "argv": [
          "{python}",
          "pc/led_cli.py",
          "status"
        ],
        "idempotent": true,
        "timeout": 10,
        "read_only": true
      }
    },
    "hardware": {
      "mcu": "ESP32-S3",
      "toolchain": "arduino",
      "signal_pin": "GPIO38",
      "flash_port": "COM7",
      "power": "独立5V 4A，与主控共地"
    },
    "manual": "docs/manual.html"
  },
  "version": 1
}
